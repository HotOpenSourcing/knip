{
  "name": "@plugins/oxlint",
  "devDependencies": {
    "oxlint": "*"
  },
  "scripts": {
    "build": "node init && oxlint --config .oxlintrc-0.json",
    "build-3": "node init && oxlint --config .oxlintrc-3.json",
    "build-4": "node init && oxlint -c .oxlintrc-4.json",
    "build-5": "node init && oxlint --config oxlint-5.config.ts"
  }
}
