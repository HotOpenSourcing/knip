{
  "name": "@plugins/tsdown",
  "devDependencies": {
    "tsdown": "*"
  },
  "scripts": {
    "build": "node init && tsdown",
    "build-3": "node init && tsdown --config tsdown.config-3.ts",
    "build-4": "node init && tsdown -c tsdown.config-4.ts"
  },
  "tsdown": {
    "entry": [
      "entry-5.ts"
    ],
    "deps": {
      "neverBundle": [
        "legacy-external"
      ]
    }
  },
  "dependencies": {
    "wasm-sandbox": "*",
    "legacy-external": "*"
  }
}
